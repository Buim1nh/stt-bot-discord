# --- Discord ---
# Lấy ở https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (tab General Information)
DISCORD_CLIENT_ID=
# ID server chơi D&D (bật Developer Mode trong Discord, chuột phải server -> Copy Server ID)
DISCORD_GUILD_ID=
# (Tuỳ chọn) chỉ người có role này mới được /record start|stop. Bỏ trống = ai cũng được.
DM_ROLE_ID=

# --- Ghi âm ---
# Im lặng bao lâu (ms) thì cắt sang đoạn mới
SILENCE_MS=1200
# Một đoạn dài tối đa bao lâu (ms) trước khi bị cắt cưỡng bức
MAX_SEGMENT_MS=90000
# Đoạn ngắn hơn ngần này (ms) thì bỏ (tiếng gõ phím, ho...)
MIN_SEGMENT_MS=400
# Thư mục lưu session
SESSIONS_DIR=sessions

# --- Speech to text (faster-whisper) ---
# Đường dẫn python trong venv (setup.ps1 tự tạo)
PYTHON_BIN=stt/.venv/Scripts/python.exe
# large-v3-turbo (~2GB VRAM, nhanh) | large-v3 (~3GB, chính xác hơn) | medium
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=vi
WHISPER_BEAM_SIZE=5

# --- LLM hậu kỳ ---
# claude (dùng Claude Code đã đăng nhập bằng gói Pro) | gemini (Gemini CLI) | none (chỉ làm transcript thô)
LLM_PROVIDER=claude
# Bỏ trống = model mặc định của Claude Code. Ví dụ: sonnet, opus
LLM_MODEL=
# (Tuỳ chọn) token dài hạn của gói Pro, tạo bằng lệnh "claude setup-token".
# Bỏ trống nếu đã đăng nhập bằng "claude auth login".
CLAUDE_OAUTH_TOKEN=
# Số ký tự transcript mỗi lần gửi LLM để làm sạch
LLM_CHUNK_CHARS=14000
# Timeout mỗi lần gọi LLM (giây)
LLM_TIMEOUT_SEC=900
